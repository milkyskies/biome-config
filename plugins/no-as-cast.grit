language js(typescript)

// Bans TypeScript `as` type assertions. Allowed exceptions:
//   - `value as const`         (narrowing, sound)
//   - `import { x as y }`      (import alias, not a type assertion)
//   - `import * as ns`         (namespace import, not a type assertion)
// For legitimate one-off uses, suppress with:
//   `// biome-ignore lint/plugin: <reason>`
// or broadly:
//   `// biome-ignore lint: <reason>`
`$x as $t` as $node where {
	$node <: TsAsExpression(),
	$t <: not TsReferenceType(name = `const`),
	register_diagnostic(
		span = $node,
		message = "Type assertion (`as`) is banned. Use `Schema.decodeUnknown`, a type guard, or fix the source type. `as const` is allowed. For unavoidable cases, suppress with `// biome-ignore lint/plugin: <reason>`."
	)
}
